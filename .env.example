# air-sentiment — every configuration key, with its default.
#
# Copy to `.env` (git-ignored) and edit. Every key is read by pydantic-settings
# from the environment with the prefix AIR_SENTIMENT__ and `__` as the nesting
# delimiter, so anything here can equally be set by an orchestrator.
#
# Values shown are the defaults; lines that are commented out have no default
# (they are None) and setting them to an empty string is NOT the same thing.
# Complex types (lists) are parsed as JSON.
#
# Keys marked [SECRET] must be injected at deploy time, never committed.

# ── Application ───────────────────────────────────────────────────────────────

# development | staging | production | test. `production` refuses the escape
# hatches below (SECURITY__ALLOW_UNAUTHENTICATED, SECURITY__LOG_RAW_TEXT).
AIR_SENTIMENT__APP__ENV=development
# Bind address. Containers bind all interfaces by design.
AIR_SENTIMENT__APP__HOST=0.0.0.0
AIR_SENTIMENT__APP__PORT=8080
# Uvicorn worker processes.
AIR_SENTIMENT__APP__WORKERS=2
# ASGI root_path when served behind a path-stripping proxy, e.g. /sentiment.
AIR_SENTIMENT__APP__ROOT_PATH=
# Serve /docs and /redoc. Turn off in production.
AIR_SENTIMENT__APP__DOCS_ENABLED=true
# Ingress body cap in bytes; oversize bodies are a 400.
AIR_SENTIMENT__APP__MAX_BODY_BYTES=1048576
# Hard cap on items in one batch request.
AIR_SENTIMENT__APP__MAX_BATCH_ITEMS=100
# How many batch items are analysed concurrently.
AIR_SENTIMENT__APP__BATCH_CONCURRENCY=8
# Seconds to drain in-flight requests on SIGTERM.
AIR_SENTIMENT__APP__SHUTDOWN_GRACE_SECONDS=15.0

# ── Escalation ladder ─────────────────────────────────────────────────────────
# Per-rung gating. Raising a confidence floor escalates more traffic (accuracy
# up, cost up); lowering it does the reverse. margin_floor of 0 disables the
# top-1-minus-top-2 check. Defaults mirror docs/02-lld.md §5.

# T0 — rules, lexicon shortcuts, cache hits.
AIR_SENTIMENT__TIERS__T0_RULES__ENABLED=true
AIR_SENTIMENT__TIERS__T0_RULES__CONFIDENCE_FLOOR=0.95
AIR_SENTIMENT__TIERS__T0_RULES__MARGIN_FLOOR=0.0
AIR_SENTIMENT__TIERS__T0_RULES__TIMEOUT_MS=5

# T1 — ONNX classifier + lexicon ensemble.
AIR_SENTIMENT__TIERS__T1_CLASSIFIER__ENABLED=true
AIR_SENTIMENT__TIERS__T1_CLASSIFIER__CONFIDENCE_FLOOR=0.80
AIR_SENTIMENT__TIERS__T1_CLASSIFIER__MARGIN_FLOOR=0.25
AIR_SENTIMENT__TIERS__T1_CLASSIFIER__TIMEOUT_MS=200

# T2 — local LLM via Ollama.
AIR_SENTIMENT__TIERS__T2_LOCAL_LLM__ENABLED=true
AIR_SENTIMENT__TIERS__T2_LOCAL_LLM__CONFIDENCE_FLOOR=0.72
AIR_SENTIMENT__TIERS__T2_LOCAL_LLM__MARGIN_FLOOR=0.20
AIR_SENTIMENT__TIERS__T2_LOCAL_LLM__TIMEOUT_MS=4000

# T3 — cloud LLM. Set ENABLED=false to guarantee no text leaves the host.
AIR_SENTIMENT__TIERS__T3_CLOUD_LLM__ENABLED=true
AIR_SENTIMENT__TIERS__T3_CLOUD_LLM__CONFIDENCE_FLOOR=0.65
AIR_SENTIMENT__TIERS__T3_CLOUD_LLM__MARGIN_FLOOR=0.15
AIR_SENTIMENT__TIERS__T3_CLOUD_LLM__TIMEOUT_MS=8000

# Complexity triggers shared by the policy.
# Inputs longer than this many tokens escalate when other signals are weak.
AIR_SENTIMENT__TIERS__LONG_INPUT_TOKENS=120
# Negation count at or above this escalates ("not bad, but never again").
AIR_SENTIMENT__TIERS__NEGATION_THRESHOLD=2
# Contrastive conjunctions only escalate above this token count.
AIR_SENTIMENT__TIERS__CONTRASTIVE_MIN_TOKENS=8

# ── Providers ─────────────────────────────────────────────────────────────────

# Cloud failover order, JSON array. First healthy + configured + breaker-closed wins.
AIR_SENTIMENT__PROVIDERS__PREFERENCE=["anthropic","openai"]

# Anthropic — the default cloud provider.
# [SECRET] Absent means the provider is simply not configured, and is skipped.
#AIR_SENTIMENT__PROVIDERS__ANTHROPIC__API_KEY=sk-ant-...
# Override for a gateway or proxy; unset uses the SDK default.
#AIR_SENTIMENT__PROVIDERS__ANTHROPIC__BASE_URL=https://api.anthropic.com
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__MODEL=claude-haiku-4-5
# Invoked only when the default model reports low confidence.
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__ARBITER_MODEL=claude-sonnet-5
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__ARBITRATION_ENABLED=true
# Confidence below which the arbiter model is called.
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__ARBITRATION_FLOOR=0.65
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__MAX_TOKENS=1024
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__ARBITER_MAX_TOKENS=2048
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__TIMEOUT_S=20.0
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__MAX_RETRIES=2
# Prompt caching needs a >=4096-token stable prefix on Haiku 4.5 to take effect.
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__PROMPT_CACHE_ENABLED=true
# 5m | 1h
AIR_SENTIMENT__PROVIDERS__ANTHROPIC__PROMPT_CACHE_TTL=1h

# OpenAI — alternate cloud provider behind the same protocol.
# [SECRET]
#AIR_SENTIMENT__PROVIDERS__OPENAI__API_KEY=sk-...
#AIR_SENTIMENT__PROVIDERS__OPENAI__BASE_URL=https://api.openai.com/v1
AIR_SENTIMENT__PROVIDERS__OPENAI__MODEL=gpt-4.1-mini
AIR_SENTIMENT__PROVIDERS__OPENAI__ARBITER_MODEL=gpt-4.1
AIR_SENTIMENT__PROVIDERS__OPENAI__ARBITRATION_ENABLED=true
AIR_SENTIMENT__PROVIDERS__OPENAI__ARBITRATION_FLOOR=0.65
AIR_SENTIMENT__PROVIDERS__OPENAI__MAX_TOKENS=1024
AIR_SENTIMENT__PROVIDERS__OPENAI__ARBITER_MAX_TOKENS=2048
AIR_SENTIMENT__PROVIDERS__OPENAI__TIMEOUT_S=20.0
AIR_SENTIMENT__PROVIDERS__OPENAI__MAX_RETRIES=2

# Ollama — Tier 2, local and free. `http://ollama:11434` under compose.
AIR_SENTIMENT__PROVIDERS__OLLAMA__ENABLED=true
AIR_SENTIMENT__PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434
AIR_SENTIMENT__PROVIDERS__OLLAMA__MODEL=llama3.2:3b
AIR_SENTIMENT__PROVIDERS__OLLAMA__TIMEOUT_S=15.0
AIR_SENTIMENT__PROVIDERS__OLLAMA__NUM_CTX=4096
# How long Ollama keeps the model resident between calls.
AIR_SENTIMENT__PROVIDERS__OLLAMA__KEEP_ALIVE=10m

# air-infra gateway — route ALL model calls (T2 local + T3 cloud) through
# air-infra instead of the SDKs. When enabled, the provider keys above are not
# used here; they live in air-infra, which owns routing, cost and cache. The
# MODEL names above still choose which model each rung asks for.
AIR_SENTIMENT__PROVIDERS__GATEWAY__ENABLED=false
AIR_SENTIMENT__PROVIDERS__GATEWAY__BASE_URL=http://localhost:8080  # http://gateway:8080 under compose
# air-infra service token, sent as X-API-Key (must be one air-infra accepts).
AIR_SENTIMENT__PROVIDERS__GATEWAY__API_KEY=air-sentiment-dev
AIR_SENTIMENT__PROVIDERS__GATEWAY__TIMEOUT_S=20.0
AIR_SENTIMENT__PROVIDERS__GATEWAY__MAX_RETRIES=2

# ── Tier-1 classifier ─────────────────────────────────────────────────────────
# Unset means no ONNX artifact, and the tier falls back to the lexicon scorer.
# The Docker image bakes the model in and sets both paths to /opt/models/*.
#AIR_SENTIMENT__CLASSIFIER__MODEL_PATH=/opt/models/model.onnx
#AIR_SENTIMENT__CLASSIFIER__TOKENIZER_PATH=/opt/models/tokenizer.json
# Temperature scaling fitted on the calibration set; 1.0 means uncalibrated.
AIR_SENTIMENT__CLASSIFIER__CALIBRATION_TEMPERATURE=1.0
# Weight of the lexicon score when blending with the neural score.
AIR_SENTIMENT__CLASSIFIER__LEXICON_WEIGHT=0.3
# Text is truncated to this many characters before scoring.
AIR_SENTIMENT__CLASSIFIER__MAX_INPUT_CHARS=4000
# Languages the artifact was trained on; anything else escalates. JSON array.
AIR_SENTIMENT__CLASSIFIER__SUPPORTED_LANGUAGES=["en"]

# ── Cache ─────────────────────────────────────────────────────────────────────

# memory | redis | none. `redis` is required for more than one replica.
AIR_SENTIMENT__CACHE__BACKEND=memory
# Verdict cache TTL; 0 disables expiry.
AIR_SENTIMENT__CACHE__TTL_SECONDS=3600
# How long an Idempotency-Key replay returns the stored response.
AIR_SENTIMENT__CACHE__IDEMPOTENCY_TTL_SECONDS=86400
# In-process backend only: entries held before LRU eviction.
AIR_SENTIMENT__CACHE__MAX_ENTRIES=10000
# `redis://redis:6379/0` under compose.
AIR_SENTIMENT__CACHE__REDIS_URL=redis://localhost:6379/0
# Namespace for every key this service writes.
AIR_SENTIMENT__CACHE__KEY_PREFIX=air:sent:

# ── Resilience ────────────────────────────────────────────────────────────────

# Consecutive failures before a provider's breaker opens.
AIR_SENTIMENT__RESILIENCE__BREAKER_THRESHOLD=5
# Seconds an open breaker waits before the half-open probe.
AIR_SENTIMENT__RESILIENCE__BREAKER_COOLDOWN_S=30.0
# Concurrent probes allowed while half-open.
AIR_SENTIMENT__RESILIENCE__BREAKER_HALF_OPEN_MAX=1
# Bulkhead width across all LLM calls, local and cloud.
AIR_SENTIMENT__RESILIENCE__LLM_CONCURRENCY=8
# Seconds to wait for a bulkhead slot before shedding to the next tier.
AIR_SENTIMENT__RESILIENCE__BULKHEAD_ACQUIRE_TIMEOUT_S=2.0
# Retries per remote call, on top of the first attempt.
AIR_SENTIMENT__RESILIENCE__RETRY_ATTEMPTS=2
AIR_SENTIMENT__RESILIENCE__RETRY_BASE_DELAY_MS=120
AIR_SENTIMENT__RESILIENCE__RETRY_MAX_DELAY_MS=4000

# ── Security ──────────────────────────────────────────────────────────────────

# [SECRET] JSON array of key records. Inline wins over the file below.
# Each record: {"id","name","key_hash","scopes":[],"max_tier","force_pii_redaction",
#               "rate_limit_rpm","burst","enabled"}. key_hash is sha256(salt + raw key).
#AIR_SENTIMENT__SECURITY__API_KEYS_INLINE=[{"id":"demo","name":"demo","key_hash":"<64 hex>","scopes":["sentiment:read"]}]
# [SECRET] Path to the same JSON, e.g. a mounted secret.
#AIR_SENTIMENT__SECURITY__API_KEYS_FILE=/run/secrets/api_keys.json
# Development escape hatch: accept unauthenticated calls. Refused when ENV=production.
AIR_SENTIMENT__SECURITY__ALLOW_UNAUTHENTICATED=false
# [SECRET] Salt for key hashing. Changing it invalidates every existing key_hash.
AIR_SENTIMENT__SECURITY__HASH_SALT=air-sentiment-dev-salt
# Fallback rate limit for keys that do not carry their own.
AIR_SENTIMENT__SECURITY__DEFAULT_RATE_LIMIT_RPM=600
AIR_SENTIMENT__SECURITY__DEFAULT_BURST=60
# Log request text verbatim. Deliberate opt-in; refused when ENV=production.
AIR_SENTIMENT__SECURITY__LOG_RAW_TEXT=false

# ── Observability ─────────────────────────────────────────────────────────────

# Appears in logs, metrics and traces as the service identity.
AIR_SENTIMENT__OBS__SERVICE_NAME=air-sentiment
# DEBUG | INFO | WARNING | ERROR
AIR_SENTIMENT__OBS__LOG_LEVEL=INFO
# json for shipping, console for a readable local terminal.
AIR_SENTIMENT__OBS__LOG_FORMAT=json
AIR_SENTIMENT__OBS__METRICS_ENABLED=true
AIR_SENTIMENT__OBS__METRICS_PATH=/metrics
AIR_SENTIMENT__OBS__OTEL_ENABLED=false
# OTLP/HTTP collector endpoint; required when OTEL_ENABLED is true.
#AIR_SENTIMENT__OBS__OTEL_ENDPOINT=http://otel-collector:4318
# Trace sampling ratio, 0.0–1.0.
AIR_SENTIMENT__OBS__OTEL_SAMPLE_RATIO=1.0
