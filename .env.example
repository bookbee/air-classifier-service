# air-classifier-service — every configuration key, with its default.
#
# Copy to `.env` (git-ignored) and edit. Every key is read by pydantic-settings
# from the environment with the prefix AIR_CLASSIFIER__ and `__` as the nesting
# delimiter, so anything here can equally be set by an orchestrator.
#
# Values shown are the defaults; lines that are commented out have no default
# (they are None) and setting them to an empty string is NOT the same thing.
# Complex types (lists) are parsed as JSON.
#
# Keys marked [SECRET] must be injected at deploy time, never committed.

# ── Application ───────────────────────────────────────────────────────────────

# development | staging | production | test. `production` refuses the escape
# hatches below (SECURITY__ALLOW_UNAUTHENTICATED, SECURITY__LOG_RAW_TEXT).
AIR_CLASSIFIER__APP__ENV=development
# Bind address. Containers bind all interfaces by design.
AIR_CLASSIFIER__APP__HOST=0.0.0.0
# 8082 is this service's slot in the AIR port map (air-infra/README.md). Model
# calls go to air-llm on its own port — see AIR_LLM below — not to anything here.
AIR_CLASSIFIER__APP__PORT=8082
# Uvicorn worker processes.
AIR_CLASSIFIER__APP__WORKERS=2
# ASGI root_path when served behind a path-stripping proxy, e.g. /classifier.
AIR_CLASSIFIER__APP__ROOT_PATH=
# Serve /docs and /redoc. Turn off in production.
AIR_CLASSIFIER__APP__DOCS_ENABLED=true
# Ingress body cap in bytes; oversize bodies are a 400.
AIR_CLASSIFIER__APP__MAX_BODY_BYTES=1048576
# Hard cap on items in one batch request.
AIR_CLASSIFIER__APP__MAX_BATCH_ITEMS=100
# How many batch items are analysed concurrently.
AIR_CLASSIFIER__APP__BATCH_CONCURRENCY=8
# Seconds to drain in-flight requests on SIGTERM.
AIR_CLASSIFIER__APP__SHUTDOWN_GRACE_SECONDS=15.0

# ── Escalation ladder ─────────────────────────────────────────────────────────
# Per-rung gating. Raising a confidence floor escalates more traffic (accuracy
# up, cost up); lowering it does the reverse. margin_floor of 0 disables the
# top-1-minus-top-2 check. Defaults mirror docs/02-lld.md §5.

# T0 — rules, lexicon shortcuts, cache hits.
AIR_CLASSIFIER__TIERS__T0_RULES__ENABLED=true
AIR_CLASSIFIER__TIERS__T0_RULES__CONFIDENCE_FLOOR=0.95
AIR_CLASSIFIER__TIERS__T0_RULES__MARGIN_FLOOR=0.0
AIR_CLASSIFIER__TIERS__T0_RULES__TIMEOUT_MS=5

# T1 — ONNX classifier + lexicon ensemble.
AIR_CLASSIFIER__TIERS__T1_CLASSIFIER__ENABLED=true
AIR_CLASSIFIER__TIERS__T1_CLASSIFIER__CONFIDENCE_FLOOR=0.80
AIR_CLASSIFIER__TIERS__T1_CLASSIFIER__MARGIN_FLOOR=0.25
# 400ms: the zero-shot NLI backend runs four forward passes per call and
# measures p90 193ms / max 199ms inside the built container — see
# config.py::T1ClassifierSettings for the full measurement.
AIR_CLASSIFIER__TIERS__T1_CLASSIFIER__TIMEOUT_MS=400

# T2 — local LLM, via air-llm (see AIR_LLM section below).
AIR_CLASSIFIER__TIERS__T2_LOCAL_LLM__ENABLED=true
AIR_CLASSIFIER__TIERS__T2_LOCAL_LLM__CONFIDENCE_FLOOR=0.72
AIR_CLASSIFIER__TIERS__T2_LOCAL_LLM__MARGIN_FLOOR=0.20
AIR_CLASSIFIER__TIERS__T2_LOCAL_LLM__TIMEOUT_MS=4000

# T3 — cloud LLM. Set ENABLED=false to guarantee no text leaves the host.
AIR_CLASSIFIER__TIERS__T3_CLOUD_LLM__ENABLED=true
AIR_CLASSIFIER__TIERS__T3_CLOUD_LLM__CONFIDENCE_FLOOR=0.65
AIR_CLASSIFIER__TIERS__T3_CLOUD_LLM__MARGIN_FLOOR=0.15
AIR_CLASSIFIER__TIERS__T3_CLOUD_LLM__TIMEOUT_MS=8000

# Complexity triggers shared by the policy.
# Inputs longer than this many tokens escalate when other signals are weak.
AIR_CLASSIFIER__TIERS__LONG_INPUT_TOKENS=120
# Negation count at or above this escalates ("not bad, but never again").
AIR_CLASSIFIER__TIERS__NEGATION_THRESHOLD=2
# Contrastive conjunctions only escalate above this token count.
AIR_CLASSIFIER__TIERS__CONTRASTIVE_MIN_TOKENS=8

# ── Model access (air-llm) ───────────────────────────────────────────────────
# Every model call — Tier 2 local and Tier 3 cloud both — goes through air-llm,
# the platform's single model gateway. This service holds no provider SDKs and
# no provider API keys of its own: air-llm owns routing, cross-vendor failover,
# cost accounting and caching. What stays here is which named model or routing
# alias each rung asks for, and the confidence thresholds that decide whether
# the answer air-llm returns is good enough — see docs/02-lld.md §6.
#
# Not run by this repo: air-llm is started separately, `cd ../air-llm && make up`
# (see air-llm/README.md). This is the same "someone else's job to run, an env
# var to reach" relationship this service has with air-infra's redis.
AIR_CLASSIFIER__AIR_LLM__ENABLED=true
# 8083 is air-llm's slot in the AIR port map. localhost for the native inner
# loop (`make run` / `make start`); under compose this is overridden to
# `http://host.docker.internal:8083` (docker-compose.yml) since air-llm runs on
# its own network, not air-infra's.
AIR_CLASSIFIER__AIR_LLM__BASE_URL=http://localhost:8083
# [SECRET] air-llm service token, sent as X-API-Key. air-llm's own local
# .env.example already provisions "air-classifier-dev" for the "air-classifier"
# service with [chat, embeddings] granted — paste that value here for local dev.
#AIR_CLASSIFIER__AIR_LLM__TOKEN=air-classifier-dev
AIR_CLASSIFIER__AIR_LLM__TIMEOUT_S=20.0

# Tier 2 — this service's own single-entry alias (air-llm/deploy/routing.yaml),
# not a failover chain, so a down local runtime fails this call cleanly and
# *this* service's own ladder escalates to Tier 3, rather than air-llm
# silently substituting a cloud model under the Tier-2 label. Which concrete
# model that resolves to is air-llm's own config, not this service's concern.
AIR_CLASSIFIER__AIR_LLM__LOCAL_MODEL=classify-local

# Tier 3 — this service's own routing aliases (air-llm/deploy/routing.yaml),
# each carrying its own cross-vendor failover chain, defined and owned there
# for air-classifier specifically rather than shared with other consumers.
AIR_CLASSIFIER__AIR_LLM__CLOUD_MODEL=classify-default
# Invoked only when the default model reports low confidence.
AIR_CLASSIFIER__AIR_LLM__ARBITER_MODEL=classify-arbiter
AIR_CLASSIFIER__AIR_LLM__ARBITRATION_ENABLED=true
# Confidence below which the arbiter model is called.
AIR_CLASSIFIER__AIR_LLM__ARBITRATION_FLOOR=0.65
# Sized for whichever provider an alias's chain might actually reach, not just
# the primary one — a provider that bills reasoning ("thinking") tokens as
# output can starve a ceiling sized only for the cheapest chain member before
# the model ever reaches the closing brace of the structured response; a
# lower ceiling here once read as a schema failure and was really this.
AIR_CLASSIFIER__AIR_LLM__MAX_TOKENS=2048
AIR_CLASSIFIER__AIR_LLM__ARBITER_MAX_TOKENS=4096

# Customer-summary narrative refresh (/v1/summary/refresh) — its own alias,
# not one of the three above: a narrative-refresh failure degrades to the
# caller's prior narrative unchanged, so it has no ladder above it to protect
# and no need to share a chain with a classification call.
AIR_CLASSIFIER__AIR_LLM__SUMMARY_MODEL=summarize-default
AIR_CLASSIFIER__AIR_LLM__SUMMARY_MAX_TOKENS=512
AIR_CLASSIFIER__AIR_LLM__SUMMARY_TIMEOUT_S=10.0

# ── Tier-1 classifier ─────────────────────────────────────────────────────────
# Unset means no ONNX artifact, and the tier falls back to the lexicon scorer.
# The image ships without one baked in by default — produce it with
# `scripts/export_zeroshot_model.py --output ./models` and either run natively
# (reads ./models directly) or under compose, which bind-mounts the same
# directory into the container at /opt/models (docker-compose.yml). See the
# Dockerfile's `model` stage comment for the (currently inert) bake-in path.
#AIR_CLASSIFIER__CLASSIFIER__MODEL_PATH=/opt/models/model.onnx
#AIR_CLASSIFIER__CLASSIFIER__TOKENIZER_PATH=/opt/models/tokenizer.json
# zero_shot_nli | sequence_classification — which ONNX backend MODEL_PATH is.
# The two are not interchangeable at the same artifact; see
# pipeline/tiers/scorers.py's module docstring.
AIR_CLASSIFIER__CLASSIFIER__SCORER_KIND=zero_shot_nli
# Temperature scaling fitted on the calibration set; 1.0 means uncalibrated.
# Refit this against the zero-shot backend specifically — a value calibrated
# for the old sequence-classification head has no reason to still be correct.
AIR_CLASSIFIER__CLASSIFIER__CALIBRATION_TEMPERATURE=1.0
# Weight of the lexicon score when blending with the neural score.
AIR_CLASSIFIER__CLASSIFIER__LEXICON_WEIGHT=0.3
# Text is truncated to this many characters before scoring.
AIR_CLASSIFIER__CLASSIFIER__MAX_INPUT_CHARS=4000
# Languages the artifact was trained on; anything else escalates. JSON array.
AIR_CLASSIFIER__CLASSIFIER__SUPPORTED_LANGUAGES=["en"]

# ── Cache ─────────────────────────────────────────────────────────────────────

# memory | redis | none. `redis` is required for more than one replica.
AIR_CLASSIFIER__CACHE__BACKEND=memory
# Verdict cache TTL; 0 disables expiry.
AIR_CLASSIFIER__CACHE__TTL_SECONDS=3600
# How long an Idempotency-Key replay returns the stored response.
AIR_CLASSIFIER__CACHE__IDEMPOTENCY_TTL_SECONDS=86400
# In-process backend only: entries held before LRU eviction.
AIR_CLASSIFIER__CACHE__MAX_ENTRIES=10000
# air-infra's redis, which is password-protected even locally — an unauthenticated
# URL fails closed and every lookup silently degrades to a miss. Under compose the
# host is the service name: `redis://:localdevpass@redis:6379/0`.
# In production DevOps supplies a managed instance here.
AIR_CLASSIFIER__CACHE__REDIS_URL=redis://:localdevpass@localhost:6379/0
# Namespace for every key this service writes.
AIR_CLASSIFIER__CACHE__KEY_PREFIX=air:clf:

# ── Audit ─────────────────────────────────────────────────────────────────────
# An operational log of classification jobs, for support review — not
# customer state. Unlike Cache there is no zero-config in-process fallback:
# "none" is the default so nobody starts writing to a database nobody
# configured.

# mongo | none.
AIR_CLASSIFIER__AUDIT__BACKEND=none
# air-infra's mongo. Under compose the host is the service name:
# `mongodb://air:localdevpass@mongo:27017`.
#AIR_CLASSIFIER__AUDIT__MONGO_URL=mongodb://localhost:27017
AIR_CLASSIFIER__AUDIT__DATABASE=air_classifier_service
AIR_CLASSIFIER__AUDIT__COLLECTION=audit_log
# Native Mongo TTL index; entries self-expire, no cleanup job needed.
AIR_CLASSIFIER__AUDIT__TTL_DAYS=30
# Bounded queue in front of the background writer. A slow or down Mongo drops
# the newest entries past this size rather than blocking requests.
AIR_CLASSIFIER__AUDIT__QUEUE_MAX_SIZE=1000
AIR_CLASSIFIER__AUDIT__DRAIN_TIMEOUT_S=2.0

# ── Resilience ────────────────────────────────────────────────────────────────

# Consecutive failures before a provider's breaker opens.
AIR_CLASSIFIER__RESILIENCE__BREAKER_THRESHOLD=5
# Seconds an open breaker waits before the half-open probe.
AIR_CLASSIFIER__RESILIENCE__BREAKER_COOLDOWN_S=30.0
# Concurrent probes allowed while half-open.
AIR_CLASSIFIER__RESILIENCE__BREAKER_HALF_OPEN_MAX=1
# Bulkhead width across all LLM calls, local and cloud.
AIR_CLASSIFIER__RESILIENCE__LLM_CONCURRENCY=8
# Seconds to wait for a bulkhead slot before shedding to the next tier.
AIR_CLASSIFIER__RESILIENCE__BULKHEAD_ACQUIRE_TIMEOUT_S=2.0
# Retries per remote call, on top of the first attempt.
AIR_CLASSIFIER__RESILIENCE__RETRY_ATTEMPTS=2
AIR_CLASSIFIER__RESILIENCE__RETRY_BASE_DELAY_MS=120
AIR_CLASSIFIER__RESILIENCE__RETRY_MAX_DELAY_MS=4000

# ── Security ──────────────────────────────────────────────────────────────────

# [SECRET] JSON array of key records. Inline wins over the file below.
# Each record: {"id","name","key_hash","scopes":[],"max_tier","force_pii_redaction",
#               "rate_limit_rpm","burst","enabled"}. key_hash is sha256(salt + raw key).
#
# The record below is the local development key, and it is deliberately active
# rather than commented out: a checkout that boots with no keys at all 401s every
# request, which is what the ALLOW_UNAUTHENTICATED hatch used to paper over. A
# known key keeps local dev on the same auth path as staging and production.
#
#   raw key  airc_local_dev_key   <- what callers send as X-API-Key
#   hash     sha256(HASH_SALT + raw key), with the dev salt below
#
# It is public, single-purpose and only ever valid against this salt. Real
# deployments override both this and HASH_SALT, and losing that override is not
# silent: the digest below stops matching the moment the salt changes.
AIR_CLASSIFIER__SECURITY__API_KEYS_INLINE=[{"id":"local-dev","name":"Local development","key_hash":"9ad4d249e63199d6a383fca073629b7f24bafefb682ddeb9c27c641bdfbd855e","scopes":["classify:read","admin:read"]}]
# [SECRET] Path to the same JSON, e.g. a mounted secret.
#AIR_CLASSIFIER__SECURITY__API_KEYS_FILE=/run/secrets/api_keys.json
# Development escape hatch: accept unauthenticated calls. Refused when ENV=production.
# Left off on purpose — local dev authenticates with the key above instead.
AIR_CLASSIFIER__SECURITY__ALLOW_UNAUTHENTICATED=false
# [SECRET] Salt for key hashing. Changing it invalidates every existing key_hash.
AIR_CLASSIFIER__SECURITY__HASH_SALT=air-classifier-service-dev-salt
# Fallback rate limit for keys that do not carry their own.
AIR_CLASSIFIER__SECURITY__DEFAULT_RATE_LIMIT_RPM=600
AIR_CLASSIFIER__SECURITY__DEFAULT_BURST=60
# Log request text verbatim. Deliberate opt-in; refused when ENV=production.
AIR_CLASSIFIER__SECURITY__LOG_RAW_TEXT=false

# ── Observability ─────────────────────────────────────────────────────────────

# Appears in logs, metrics and traces as the service identity.
AIR_CLASSIFIER__OBS__SERVICE_NAME=air-classifier-service
# DEBUG | INFO | WARNING | ERROR
AIR_CLASSIFIER__OBS__LOG_LEVEL=INFO
# json for shipping, console for a readable local terminal.
AIR_CLASSIFIER__OBS__LOG_FORMAT=json
AIR_CLASSIFIER__OBS__METRICS_ENABLED=true
AIR_CLASSIFIER__OBS__METRICS_PATH=/metrics
AIR_CLASSIFIER__OBS__OTEL_ENABLED=false
# OTLP/HTTP collector endpoint; required when OTEL_ENABLED is true.
#AIR_CLASSIFIER__OBS__OTEL_ENDPOINT=http://otel-collector:4318
# Trace sampling ratio, 0.0–1.0.
AIR_CLASSIFIER__OBS__OTEL_SAMPLE_RATIO=1.0
